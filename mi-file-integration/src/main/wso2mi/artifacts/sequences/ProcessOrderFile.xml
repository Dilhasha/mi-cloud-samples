<?xml version="1.0" encoding="UTF-8"?>
<sequence name="ProcessOrderFile" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <variable name="fileName" type="STRING" expression="${headers[&quot;FILE_NAME&quot;]}"/>
    <log category="INFO">
        <message>Picked up order file ${vars.fileName}</message>
    </log>
    <payloadFactory media-type="json" template-type="freemarker">
        <format><![CDATA[<#assign total = 0><#list payload.items as item><#assign total = total + item.qty * item.price></#list>{
    "orderId": "${payload.orderId}",
    "itemCount": ${payload.items?size},
    "total": ${total?c},
    "sourceFile": "${vars.fileName}"
}]]></format>
    </payloadFactory>
    <file.write configKey="FILE_CONN">
        <filePath>{${"/outbox/" + vars.fileName}}</filePath>
        <mimeType>application/json</mimeType>
        <writeMode>Overwrite</writeMode>
        <responseVariable>file_write_summary</responseVariable>
        <overwriteBody>false</overwriteBody>
    </file.write>
    <log category="INFO">
        <message>Wrote order summary /tmp/mi-files/outbox/${vars.fileName}: ${payload}</message>
    </log>
    <drop/>
</sequence>
